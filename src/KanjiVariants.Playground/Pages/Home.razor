@inject IJSRuntime JS

<PageTitle>KanjiVariants Playground — 漢字を調べる・変換する</PageTitle>
<div class="shell">
    <header class="topbar">
        <a class="brand" href="./" aria-label="KanjiVariants Playground ホーム"><span class="brand-mark" aria-hidden="true">字</span> KanjiVariants</a>
        <label class="theme-control">表示
            <select aria-label="表示テーマ" @onchange="ChangeTheme">
                <option value="system">システム</option><option value="light">ライト</option><option value="dark">ダーク</option>
            </select>
        </label>
    </header>
    <main id="main">
        <section class="intro" aria-labelledby="page-title">
            <p class="eyebrow">漢字の違いを、調べる。変換する。</p>
            <h1 id="page-title">KanjiVariants <span>Playground</span></h1>
            <p class="lead">「髙橋𠮷野」を「高橋吉野」へ。<br />文章の一括変換と、文字集合への適合・代替候補の診断を試せます。</p>
            <p class="privacy"><span aria-hidden="true">●</span> 変換・診断はこのブラウザ内で完結します。入力内容は送信しません。</p>
        </section>
        <div class="mode-switch" role="group" aria-label="機能の選択">
            <button type="button" aria-pressed="@((!diagnostic).ToString().ToLowerInvariant())" aria-controls="conversion-mode" @onclick="() => diagnostic = false">文字列変換</button>
            <button type="button" aria-pressed="@diagnostic.ToString().ToLowerInvariant()" aria-controls="diagnostic-mode" @onclick="() => diagnostic = true">文字列診断</button>
        </div>
        <p class="help mode-help">入力・設定・結果は各画面で別々に保持します。切り替えても失われません。</p>
        <div id="conversion-mode" hidden="@diagnostic"><ConversionPanel /></div>
        <div id="diagnostic-mode" hidden="@(!diagnostic)"><DiagnosticPanel /></div>
        <aside class="notes">
            <h2>判定・変換の読み方</h2>
            <p>KanjiVariantsの文字列APIの規則で判定します。ASCII（制御文字を含む）は各集合で使用可能として扱います。Shift-JIS・CP932などへのエンコード可否を示すものではありません。</p>
            <p>IVS・SVS付き表現は、そのままではすべての対象集合で対象外です。診断画面ではVariation Selectorを自動で取り除きません。変換画面ではMJの一意な縮退先を優先し、追加の基底文字フォールバックは明示的に許可した場合だけ行います。</p>
            <p>代替候補はMJ縮退マップ由来で、旧字体・異体字を網羅する辞書ではありません。候補の一覧があっても、一意な変換先が決まらなければ自動変換しません。表示される字体は端末のフォントにも依存します。</p>
        </aside>
    </main>
    <footer>
        <span>KanjiVariants 1.2.0 · .NET 10 / WebAssembly</span>
        <nav aria-label="関連リンク"><a href="https://github.com/Koichi-Kobayashi/KanjiVariants">KanjiVariants本体 ↗</a><a href="https://github.com/Koichi-Kobayashi/KanjiVariants.Playground">Playground GitHub ↗</a><a href="licenses.html">ライセンス・データ出典</a></nav>
    </footer>
</div>

@code {
    private bool diagnostic;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeVoidAsync("playground.markReady");
    }
    private async Task ChangeTheme(ChangeEventArgs args) => await JS.InvokeVoidAsync("playground.setTheme", args.Value?.ToString() ?? "system");
}
