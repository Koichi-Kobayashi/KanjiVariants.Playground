@inject ClipboardService Clipboard
@inject CharacterDetailsService Details

<div class="panel result-panel">
    <div class="summary" role="status">
        <span class="badge @(Result.IsSupported ? "success" : "warning")">@(Result.IsSupported ? "すべて使用可能" : "対象外の文字あり")</span>
        <p><strong>@Result.Target.Label</strong> · @Result.Rows.Count 単位中 @Result.Rows.Count(x => !x.Item.IsSupported) 単位が対象外</p>
        <p class="help">診断した入力：<span class="original-text">@Result.Text</span></p>
        <p class="help">診断・候補検索 @Result.ElapsedMilliseconds.ToString("F1") ms（配信・画面描画時間を除く）</p>
        <p class="help">元の表現の適合判定はVSを保持したまま行います。候補はすべて @Result.Target.Label で使用可能です。「許可時の変換先」はフォールバックONのAPIが選ぶ文字で、MJの一意な縮退先が優先されます。自動変更は行いません。</p>
    </div>
    <div class="table-scroll">
        <table>
            <caption class="sr-only">@Result.Target.Label の判定と代替候補。位置は0始まりのUTF-16単位です。</caption>
            <thead><tr><th scope="col">元の文字</th><th scope="col">判定</th><th scope="col">代替候補 · @Result.Target.Label</th></tr></thead>
            <tbody>
                @foreach (var row in Result.Rows)
                {
                    var expansion = session.GetExpansion(row.Item.Utf16Index);
                    <tr>
                        <th scope="row"><button type="button" class="detail-toggle" @onclick="() => session.Toggle(row.Item)"
                            aria-expanded="@((expansion is not null).ToString().ToLowerInvariant())"
                            aria-controls="@DetailId(row.Item)" aria-label="@($"位置 {row.Item.Utf16Index} の文字の詳細を開閉")">
                            <span class="character">@CharacterDisplay.Visible(row.Item.Original, row.Item.Reason)</span><small>詳細 @(expansion is not null ? "−" : "＋")</small></button>
                            <span class="position">@CharacterDisplay.CodePoints(row.Item.Original, row.Item.Reason)</span><span class="position">位置 @row.Item.Utf16Index · @row.Item.Utf16Length 単位</span></th>
                        <td data-label="判定"><span class="status-dot @(row.Item.IsSupported ? "ok" : "outside")" aria-hidden="true"></span>@DiagnosticService.Explain(row.Item.Reason)</td>
                        <td data-label="代替候補">
                            @if (row.Candidates.Count > 0)
                            {
                                <div class="candidates">
                                    @foreach (var candidate in row.Candidates)
                                    {
                                        <div class="candidate-item">
                                            <button type="button" class="candidate" @onclick="() => Copy(candidate.Text)" aria-label="@($"代替候補 {candidate.Text} をコピー")"><span>@candidate.Text</span><small>コピー</small></button>
                                            <span class="position">@CharacterDisplay.CodePoints(candidate.Text)</span>
                                            <span class="candidate-kind">@(candidate.Kind == AlternativeKind.MjMapping ? "MJ縮退マップ" : "基底文字フォールバック（許可時）")</span>
                                            @if (row.HasVariationSelector && candidate.IsPreferred)
                                            { <span class="position">許可時の変換先：@CharacterDisplay.ChangeReason(candidate.SelectionReason!.Value)</span> }
                                        </div>
                                    }
                                </div>
                            }
                            else { <span class="help">@(row.Item.Reason == KanjiDiagnosticReason.UnregisteredVariationSequence
                                ? "未登録のVariation Sequenceです。基底文字への候補は追加しません。"
                                : row.CanSearchAlternatives ? "この文字集合で使える候補はありません" : "候補検索の対象外（漢字または登録済みIVS・SVSではありません）")</span> }
                            @if (row.Candidates.Any(x => x.Kind == AlternativeKind.VariationSelectorFallback
                                || x.SelectionReason == KanjiDiagnosticReason.VariationSelectorFallbackAvailable))
                            { <p class="help">基底文字へのフォールバックではIVS/SVSの字形情報が失われます。利用する前に確認してください。</p> }
                        </td>
                    </tr>
                    <tr class="character-detail-row" id="@DetailId(row.Item)" hidden="@(expansion is null)">
                        <td colspan="3" data-details-cachehit="@((expansion?.WasCached ?? false).ToString().ToLowerInvariant())"
                            data-details-ms="@((expansion?.LookupMilliseconds ?? 0).ToString("F3", System.Globalization.CultureInfo.InvariantCulture))"
                            data-details-cache-count="@session.CacheCount">
                            @if (expansion is not null)
                            { <CharacterDetails Model="expansion.Model" Item="row.Item" /> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Result.Rows.Count == 0) { <p>入力は空です。ライブラリの規則では使用可能として扱います。</p> }
    <p class="help" role="status">@copyStatus</p>
</div>

@code {
    [Parameter, EditorRequired] public PlaygroundResult Result { get; set; } = default!;
    private string copyStatus = "候補を押すと、その文字だけをコピーします。入力は変更しません。";
    private CharacterDetailsSession session = default!;
    private PlaygroundResult? previousResult;
    private readonly string resultId = Guid.NewGuid().ToString("N");
    private string DetailId(KanjiTextDiagnosticItem item) => $"character-detail-{resultId}-{item.Utf16Index}";
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(previousResult, Result)) return;
        previousResult = Result;
        session = new CharacterDetailsSession(Details.Get);
        copyStatus = "候補を押すと、その文字だけをコピーします。入力は変更しません。";
    }
    private async Task Copy(string candidate)
    {
        copyStatus = await Clipboard.CopyAsync(candidate) ? $"「{candidate}」をコピーしました。"
            : $"コピーできませんでした。候補「{candidate}」を選択して手動でコピーしてください。";
    }
}
